# ======================================================================
# NEXTAI OFFICE SUITE - BACKEND & CMS CONFIGURATION (PORT: 6033)
# ======================================================================

PORT=6033
NODE_ENV=development

# JWT Secret for CMS Admin Auth
JWT_SECRET=nextai_jwt_super_secret_key_change_in_production_2026

# Cloudflare R2 Storage (S3 Compatible API)
CLOUDFLARE_R2_ACCOUNT_ID=demo_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY=demo_r2_access_key_id
CLOUDFLARE_R2_SECRET_KEY=demo_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=nextai-office-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.nextaitechnology.com

# AI Assistant LLM Gateway (OpenAI or Gemini)
OPENAI_API_KEY=sk-demo-ai-proxy-key-replace-with-real-key
GEMINI_API_KEY=AIzaSyDemoGeminiKeyReplaceInProduction

# Google Play Developer API Service Account (for S2S IAP verification)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=./config/google-service-account.json
